{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A project entry in the identity dashboard",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Project name" },
        "githubAccount": { "type": "string", "enum": ["Personal", "Work", "Freelance"] },
        "githubRepoUrl": { "type": "string", "format": "uri" },
        "vercelAccount": { "type": "string", "description": "Linked Vercel account email" },
        "supabaseProject": { "type": "string", "description": "Supabase project ID or name" },
        "credentials": { "type": "string", "description": "AES encrypted credentials JSON" },
        "status": { "type": "boolean", "description": "Active or paused status" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the project owner" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "githubAccount", "ownerId", "createdAt"]
    }
  },
  "firestore": {
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of managed projects"
    }
  }
}
